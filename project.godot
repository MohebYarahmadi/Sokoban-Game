; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sokoban"
config/tags=PackedStringArray("jumpstarter")
run/main_scene="uid://bd8163sl6xcut"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="uid://by2d57qwpkxnr"

[autoload]

GameManager="*res://Globals/gameManager.gd"
LevelData="*res://Globals/levelData.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="viewport"

[editor]

naming/node_name_num_separator=2
naming/scene_name_casing=1
naming/script_name_casing=4

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Classes/": "purple",
"res://Data/": "pink",
"res://Globals/": "yellow",
"res://Resources/": "orange",
"res://Scenes/": "red",
"res://addons/": "gray"
}

